-- 4. สวิตช์ดึงทุกคนมาหาตลอดเวลา
MainTab:CreateToggle({
   Name = "ดึงทุกคนมาหาเรื่อยๆ (Bring All Loop)",
   CurrentValue = false,
   Flag = "BringLoopToggle",
   Callback = function(Value)
      BringPlayersLoop = Value
      task.spawn(function()
         while BringPlayersLoop do
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
               local myPos = LocalPlayer.Character.HumanoidRootPart.CFrame
               for _, player in pairs(Players:GetPlayers()) do
                  if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                     player.Character.HumanoidRootPart.CFrame = myPos * CFrame.new(0, 0, -3)
                  end
               end
            end
            task.wait(0.1)
         end
      end)
   end,
})

-- 5. แปลงร่างเป็นไก่
FunTab:CreateToggle({
   Name = "แปลงร่างเป็นไก่ 🐔",
   CurrentValue = false,
   Flag = "ChickenToggle",
   Callback = function(Value)
      isChicken = Value
      local char = LocalPlayer.Character
      if not char then return end
      
      if isChicken then
         -- เปลี่ยนสัดส่วนตัวละครให้เหมือนไก่ (ย่อตัวลงและปรับสีเหลือง)
         for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
               part.Color = Color3.fromRGB(255, 204, 0) -- สีเหลืองทอง
            end
         end
         if char:FindFirstChild("Humanoid") then
            char.Humanoid.HipHeight = -1 -- ย่อตัวติดพื้น
         end
         Rayfield:Notify({ Title = "แปลงร่าง!", Content = "คุณกลายเป็นไก่แล้ว กุ๊กๆ 🐔", Duration = 3, Image = 4483362458 })
      else
         -- คืนร่างเดิม
         if char:FindFirstChild("Humanoid") then
            char.Humanoid.HipHeight = 0
         end
         Rayfield:Notify({ Title = "คืนร่าง!", Content = "คุณกลับร่างเดิมเรียบร้อย", Duration = 3, Image = 4483362458 })
      end
   end,
})

