-- ตัวแปรบริการ Roblox
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local ESPEnabled = false
local LockTargetEnabled = false
local BringPlayersLoop = false
local isChicken = false

-- ฟังก์ชันตรวจสอบบทบาทและคืนค่า (ชื่อภาษาไทย, สี)
local function GetRoleInfo(player)
    local roleName = "คนธรรมดา"
    local color = Color3.fromRGB(0, 255, 0) -- สีเขียว
    
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    
    local hasGun = (backpack and backpack:FindFirstChild("Gun")) or (character and character:FindFirstChild("Gun"))
    local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or (character and character:FindFirstChild("Knife"))
    
    if hasKnife then
        roleName = "ไอชั่ว"
        color = Color3.fromRGB(255, 0, 0) -- สีแดง
    elseif hasGun then
        roleName = "ตำรวจ"
        color = Color3.fromRGB(0, 0, 255) -- สีน้ำเงิน
    end
    
    return roleName, color
end

-- ==================== ระบบ ESP ====================
local espBoxes = {}

local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Filled = false
    box.Transparent = 1
    box.Visible = false
    
    local text = Drawing.new("Text")
    text.Size = 16
    text.Center = true
    text.Outline = true
    text.Visible = false
    
    espBoxes[player] = {Box = box, Text = text}
end

for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(function(p)
    if espBoxes[p] then
        espBoxes[p].Box:Remove()
        espBoxes[p].Text:Remove()
        espBoxes[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for player, drawings in pairs(espBoxes) do
        if ESPEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                local roleName, roleColor = GetRoleInfo(player)
                
                local scale = 1000 / pos.Z
                drawings.Box.Size = Vector2.new(20 * scale / 10, 35 * scale / 10)
                drawings.Box.Position = Vector2.new(pos.X - drawings.Box.Size.X / 2, pos.Y - drawings.Box.Size.Y / 2)
                drawings.Box.Color = roleColor
                drawings.Box.Visible = true
                
                drawings.Text.Position = Vector2.new(pos.X, pos.Y - drawings.Box.Size.Y / 2 - 18)
                drawings.Text.Text = player.DisplayName .. " [" .. roleName .. "]"
                drawings.Text.Color = roleColor
                drawings.Text.Visible = true
            else
                drawings.Box.Visible = false
                drawings.Text.Visible = false
            end
        else
            drawings.Box.Visible = false
            drawings.Text.Visible = false
        end
    end
end)

-- ==================== ระบบล็อกเป้า (ยิงปืน / ฟันมีด) ====================
local function GetClosestTarget()
    local closestPlayer = nil
    local shortestDistance = math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.Humanoid.Health > 0 then
            local screenPos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            if onScreen then
                local mousePos = game:GetService("UserInputService"):GetMouseLocation()
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

RunService.RenderStepped:Connect(function()
    if LockTargetEnabled then
        local target = GetClosestTarget()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local character = LocalPlayer.Character
            if character and (character:FindFirstChild("Gun") or character:FindFirstChild("Knife")) then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
            end
        end
    end
end)

